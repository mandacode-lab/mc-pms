FROM alpine:3.23.0

# Build argument for Atlas version
ARG ATLAS_VERSION=v1.0.0

# Metadata labels
LABEL org.opencontainers.image.title="Mandacode PMS Migration"
LABEL org.opencontainers.image.description="Database migration container using Atlas CLI"
LABEL org.opencontainers.image.version="${ATLAS_VERSION}"
LABEL org.opencontainers.image.vendor="Mandacode"

# Install dependencies in a single layer
RUN apk add --no-cache \
    ca-certificates=20251003-r0 \
    curl=8.17.0-r1 \
    bash=5.3.3-r1 \
    coreutils=9.8-r1 \
    && rm -rf /var/cache/apk/*

# Install Atlas CLI with architecture detection
RUN ARCH=$(uname -m) && \
    case ${ARCH} in \
        x86_64) ARCH="amd64" ;; \
        aarch64) ARCH="arm64" ;; \
        *) echo "Unsupported architecture: ${ARCH}" && exit 1 ;; \
    esac && \
    echo "Installing Atlas CLI ${ATLAS_VERSION} for ${ARCH}..." && \
    curl -fsSL \
      "https://release.ariga.io/atlas/atlas-linux-${ARCH}-${ATLAS_VERSION}" \
      -o /usr/local/bin/atlas && \
    chmod +x /usr/local/bin/atlas && \
    atlas version

# Create non-root user for security
RUN adduser -D -u 1001 -s /bin/bash migrations && \
    mkdir -p /app /tmp && \
    chown -R 1001:1001 /app /tmp

WORKDIR /app

# Copy migration files
COPY --chown=1001:1001 ent/migrate/migrations ./migrations

# Copy and setup entrypoint script
COPY --chown=1001:1001 scripts/mig-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Switch to non-root user
USER 1001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=1 \
  CMD atlas version || exit 1

# Set entrypoint
ENTRYPOINT ["/entrypoint.sh"]
