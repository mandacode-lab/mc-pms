                            "$ref": "#/definitions/merrmid.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/merrmid.ErrorResponse"
                        }
                    }
                }
            },
