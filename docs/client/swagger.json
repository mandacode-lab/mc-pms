                "produces": [
                    "application/json"
                ],
                "tags": [
                    "client-apps"
                ],
                "summary": "List client apps",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Service ID",
                        "name": "service_id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of client apps",
                        "schema": {
                            "$ref": "#/definitions/clientapp_mgmt.ListClientAppsResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request",
